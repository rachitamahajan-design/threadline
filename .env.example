# Copy to .env and fill in. Never commit .env.
#
# Don't have a key? OpenGranola mints a sandbox one for you on first run:
#   curl -X POST https://api.pyai.com/v1/sandbox/keys
# No login, no card.

PYAI_API_KEY=pyai_test_xxxxxxxx
PYAI_BASE_URL=https://api.pyai.com/v1

# Reserved for a future PyAI knowledge-base integration. Nothing reads this
# yet — cross-meeting memory is local (see `npm run rebuild-brain`).
PYAI_KB_ID=

# Optional fallback: if PyAI is unreachable, recordings are transcribed with
# Whisper and notes extracted with GPT instead. Leave blank to run PyAI-only.
# Also powers the second-pass structured summary (sections, grounding, editing).
OPENAI_API_KEY=

# Model for the second-pass structured summary. Defaults to gpt-4o-mini.
SUMMARIZER_MODEL=

# ── Grounded notes & handoffs (src/lib/model.ts) ────────────────────────────
# Model selection, per-workflow budgets, retry policy, gates and prompt text are
# CONFIG, not env: models/budgets/retry/gates live in agents.json, the prompt
# templates in config/prompts.json. The env vars below are overrides only.
#
# Provider override. Left blank, agents.json models.chat.provider wins when its
# key is configured, else whichever key exists (OpenAI first, because the
# existing fallback path already depends on it). Either way: when the chosen
# host fails (404/timeout/dead key) and the other provider has a key, the call
# silently fails over to it — only both hosts failing surfaces to the user.
#   pyai | openai | mock
MODEL_PROVIDER=

# Chat model override on PyAI (agents.json models.chat.model.pyai otherwise).
PYAI_CHAT_MODEL=

# Per-call timeout for the model adapter, in ms. Default 60000.
MODEL_TIMEOUT_MS=

# Legacy override for the entailment gate. The gate is configured in
# agents.json (gates.entailment: blocking | advisory | off, default blocking);
# setting this to 1 only forces it at least advisory when config says off.
ENTAIL_SPOTCHECK=

# ── Logging (src/lib/log.ts) ────────────────────────────────────────────────
# Structured JSON Lines to data/logs/threadline.log, rotated by size. Location
# and rotation are config (agents.json `logging`); these are overrides.
# Never contains meeting content — ids, counts, codes and durations only.
#
# debug | info | warn | error. debug adds a line per model call.
LOG_LEVEL=

# Where the log files go. Defaults to agents.json logging.dir (data/logs).
LOG_DIR=

# Set to 0 to disable file logging entirely (console output is unaffected).
LOG_TO_FILE=
