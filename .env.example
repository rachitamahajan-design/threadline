# Copy to .env and fill in. Never commit .env.
#
# Don't have a key? OpenGranola mints a sandbox one for you on first run:
#   curl -X POST https://api.pyai.com/v1/sandbox/keys
# No login, no card.

PYAI_API_KEY=pyai_test_xxxxxxxx
PYAI_BASE_URL=https://api.pyai.com/v1

# Knowledge base backing cross-meeting memory + live Cue grounding.
# Created automatically on first run if left blank.
PYAI_KB_ID=

# Structured extraction (summaries, action items, graph entities) runs on an
# LLM of your choice — PyAI ships speech models, not text models.
ANTHROPIC_API_KEY=
