# Copy to .env and fill in. Never commit .env.
#
# Don't have a key? OpenGranola mints a sandbox one for you on first run:
#   curl -X POST https://api.pyai.com/v1/sandbox/keys
# No login, no card.

PYAI_API_KEY=pyai_test_xxxxxxxx
PYAI_BASE_URL=https://api.pyai.com/v1

# Reserved for a future PyAI knowledge-base integration. Nothing reads this
# yet — cross-meeting memory is local (see `npm run rebuild-brain`).
PYAI_KB_ID=

# Optional fallback: if PyAI is unreachable, recordings are transcribed with
# Whisper and notes extracted with GPT instead. Leave blank to run PyAI-only.
# Also powers the second-pass structured summary (sections, grounding, editing).
OPENAI_API_KEY=

# Model for the second-pass structured summary. Defaults to gpt-4o-mini.
SUMMARIZER_MODEL=

# ── Grounded notes & handoffs (src/lib/model.ts) ────────────────────────────
# All model calls for notes and handoffs go through ONE adapter, so swapping the
# provider is one line here. `pyai` posts to $PYAI_BASE_URL/chat/completions;
# `openai` to OpenAI. Left blank, whichever key exists wins (OpenAI first,
# because the existing fallback path already depends on it).
#   pyai | openai | mock
MODEL_PROVIDER=

# Chat model on PyAI, used when MODEL_PROVIDER=pyai.
PYAI_CHAT_MODEL=pyai-think

# Per-call timeout for the model adapter, in ms. Default 60000.
MODEL_TIMEOUT_MS=

# Advisory entailment spot-check: one extra cheap call that asks the model
# whether each note bullet is really supported by the segments it cites. It only
# ever ADDS a "heard poorly"-style marker — it can never delete a bullet, and the
# deterministic validators do not depend on it. Off unless set to 1.
ENTAIL_SPOTCHECK=

# Log every model call (purpose, provider, latency, temperature) to stdout.
LOG_MODEL=
