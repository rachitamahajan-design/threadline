{
  "$comment": "Capability registry. Meeting modes, model selection, per-workflow budgets, retry policy and gates are config, not code — swapping a model, resizing a budget or turning the entailment gate advisory is one edit here, no rebuild. Prompt text lives in config/prompts.json.",
  "version": 1,
  "models": {
    "transcribe_stream": { "provider": "pyai", "model": "pyai-hear", "surface": "hear.stream" },
    "transcribe_batch": { "provider": "pyai", "model": "pyai-hear", "surface": "transcription.jobs", "diarize": true },
    "recap": { "provider": "pyai", "surface": "recap.calls" },
    "extract": { "provider": "anthropic", "model": "claude-sonnet-5" },
    "chat": {
      "provider": "openai",
      "model": { "pyai": "pyai-think", "openai": "gpt-4o-mini" },
      "purposes": {
        "statements.extract": { "temperature": 0 },
        "notes": { "temperature": 0.1 },
        "entail.spotcheck": { "temperature": 0 }
      }
    },
    "pricing": {
      "pyai-think": { "in": 0.0005, "out": 0.0015 },
      "gpt-4o-mini": { "in": 0.00015, "out": 0.0006 }
    }
  },
  "budgets": {
    "per_meeting_units": 60,
    "per_meeting_ms": 180000,
    "live_assist_min_gap_ms": 20000,
    "workflows": {
      "process-meeting": { "units": 60, "ms": 180000 },
      "notes": { "units": 12, "ms": 150000 },
      "handoff": { "units": 12, "ms": 150000 },
      "cross-handoff": { "units": 16, "ms": 180000 },
      "ask": { "units": 3, "ms": 15000 },
      "needle": { "units": 4, "ms": 20000 },
      "chat": { "units": 4, "ms": 30000 },
      "diarize": { "units": 2, "ms": 600000 },
      "project-ask": { "units": 3, "ms": 30000 },
      "doc-summary": { "units": 2, "ms": 30000 }
    }
  },
  "retry": { "max_attempts": 3, "base_delay_ms": 400 },
  "gates": { "entailment": "blocking" },
  "logging": {
    "$comment": "JSON Lines to data/logs/, rotated by size. max_files is how many backups are kept, so disk is bounded at (max_files + 1) * max_bytes ≈ 30MB here. Never contains meeting content.",
    "enabled": true,
    "dir": "data/logs",
    "file": "threadline.log",
    "max_bytes": 5242880,
    "max_files": 5,
    "level": "info",
    "console": true
  },
  "modes": [
    {
      "id": "investor",
      "name": "Investor call",
      "description": "Fundraising conversations. Tracks what you committed to and what they pushed on.",
      "extract": ["decisions", "action_items", "objections", "metrics_quoted", "follow_ups"],
      "assist": {
        "watch_for": ["a metric you have quoted differently before", "a question about traction or burn", "a commitment to send materials"],
        "recall_from": "past_meetings_with_same_people"
      }
    },
    {
      "id": "discovery",
      "name": "Discovery",
      "description": "Prospect calls. Pains, blockers, who actually decides.",
      "extract": ["pains", "decision_makers", "objections", "next_steps", "action_items"],
      "assist": {
        "watch_for": ["a pricing question", "a competitor mentioned", "an objection you have heard before"],
        "recall_from": "past_meetings_on_same_topic"
      }
    },
    {
      "id": "one_on_one",
      "name": "1:1",
      "description": "Direct reports. Carries last week's commitments into this week.",
      "extract": ["action_items", "blockers", "decisions", "sentiment"],
      "assist": {
        "watch_for": ["an open action item from your last 1:1 with this person", "a blocker raised twice"],
        "recall_from": "last_meeting_with_same_person"
      }
    },
    {
      "id": "standup",
      "name": "Standup",
      "description": "Short, fast, mostly action items. Assist stays quiet.",
      "extract": ["action_items", "blockers"],
      "assist": { "watch_for": ["a blocker with no owner"], "recall_from": "none" }
    }
  ]
}
